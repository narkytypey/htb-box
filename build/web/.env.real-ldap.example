# Template for the gitignored build/web/.env.real-ldap.
#
#   cp web/.env.real-ldap.example web/.env.real-ldap
#   # then replace REPLACE_ME below before `docker compose up`
#
# The real svc_ldap password is NOT kept in this file on purpose: this
# example is committed, so anything written here is readable from git
# history and would hand players the bind credential that spec S5 expects
# them to find inside the container. The value provisioned on the DC is the
# one in dc-provisioning/02-create-users.ps1's New-ADUser call for svc_ldap.
#
# Leaving REPLACE_ME in place does not fail at startup -- the app binds
# lazily, so it surfaces as an LDAP bind failure on the first login attempt.
LDAP_SERVER_HOST=dc01.donerup.htb
LDAP_BIND_DN=CN=svc_ldap,OU=Service Accounts,DC=donerup,DC=htb
LDAP_BIND_PASSWORD=REPLACE_ME
