# Single source of truth for the Donerup network topology.
# AD_VLAN_SUBNET / AD_VLAN_HOST_IP / DC_IP describe the host bridge that
# Plan 3's Windows DC VM will be plugged into.

INTERNAL_AD_BRIDGE=internal-ad
INTERNAL_AD_SUBNET=172.28.0.0/24
WEB_INTERNAL_AD_IP=172.28.0.10
# Host-side address of the internal-ad bridge, as actually assigned by
# Docker's IPAM for INTERNAL_AD_SUBNET (confirmed via `docker network
# inspect internal-ad` -> IPAM.Config.Gateway). Not derived by string
# manipulation from INTERNAL_AD_SUBNET because Docker leaves the
# per-container Gateway field empty for `internal: true` networks, so a
# derived value could not be self-verified from inside the container.
INTERNAL_AD_GATEWAY_IP=172.28.0.1

AD_VLAN_BRIDGE=adlab0
AD_VLAN_SUBNET=10.10.20.0/24
AD_VLAN_HOST_IP=10.10.20.1
DC_IP=10.10.20.10

# HTB issues player VPN addresses out of 10.10.14.0/23 (10.10.14.0 through
# 10.10.15.255), so that is the range DONERUP_AD_PIVOT rule 1 drops by name.
# This is a deployment decision, not a placeholder: change it only if the
# target lab hands out client addresses from a different range, and keep
# tests/run_isolation_test.sh's FAKE_VPN_IP inside whatever it becomes.
# Enforcement does not rest on this line -- rule 4 default-denies every other
# source to the AD VLAN, which is what a dmz-only container hits -- so a
# wrong value here loses an explicit, countable drop, not the control itself.
VPN_CLIENT_SUBNET=10.10.14.0/23
