{
  "name": "@donerup/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Donerup Restaurant Group portal UI - React port of the Flask portal's shipped theme.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/index.css"
  },
  "files": ["dist"],
  "scripts": {
    "sync-css": "node scripts/sync-css.mjs",
    "build": "npm run sync-css && tsc -p tsconfig.build.json"
  },
  "peerDependencies": { "react": ">=18" },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
